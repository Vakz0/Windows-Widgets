{
  "manifest_version": 3,
  "name": "Lattice Media Bridge",
  "version": "1.1.1",
  "description": "Signale la lecture audio/vidéo à Lattice pour éviter l’AFK pendant une vidéo.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:17384/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Lattice Media Bridge",
    "default_popup": "popup.html"
  }
}
